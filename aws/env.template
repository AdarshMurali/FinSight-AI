# ============================================================
# AWS Environment additions — append these to backend/.env
# on BOTH your local machine AND the Flink EC2 instance
# ============================================================
# Fill in the actual IPs after launching your EC2 instances.

# ── ChromaDB EC2 (t2.micro, always-on) ──────────────────────
# Used by: FastAPI backend (local), Flink job (on AWS)
CHROMA_HOST=<CHROMADB_EC2_PUBLIC_IP>
CHROMA_PORT=8001

# ── Kafka EC2 (t3.medium, scheduled) ────────────────────────
# Used by: local trade producer, FastAPI Kafka bridge
KAFKA_BOOTSTRAP_SERVERS=<FLINK_EC2_ELASTIC_IP>:9092

# ── Flink EC2 Elastic IP ─────────────────────────────────────
# Used by: Kafka advertised listener in docker-compose
KAFKA_EXTERNAL_IP=<FLINK_EC2_ELASTIC_IP>

# ── ChromaDB EC2 IP for Flink containers ────────────────────
# Used by: Flink job containers to reach ChromaDB on t2.micro
CHROMADB_EC2_IP=<CHROMADB_EC2_PUBLIC_IP>
