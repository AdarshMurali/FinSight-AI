{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SSMDeployBothEC2s",
      "Effect": "Allow",
      "Action": [
        "ssm:SendCommand",
        "ssm:GetCommandInvocation"
      ],
      "Resource": [
        "arn:aws:ec2:ap-south-1:301276846405:instance/i-0d5332841d8f8da41",
        "arn:aws:ec2:ap-south-1:301276846405:instance/i-06df445415d082798",
        "arn:aws:ssm:ap-south-1::document/AWS-RunShellScript"
      ]
    },
    {
      "Sid": "StartStopFlinkEC2Only",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances"
      ],
      "Resource": "arn:aws:ec2:ap-south-1:301276846405:instance/i-06df445415d082798"
    },
    {
      "Sid": "DescribeInstancesReadOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus"
      ],
      "Resource": "*"
    }
  ]
}
