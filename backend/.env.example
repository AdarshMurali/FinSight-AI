# Database Configuration
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=FinSight_AI
DB_USER=sa
DB_PASSWORD=your_password_here

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# RAG / Vector Store Configuration
# Required for embeddings - get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here

# Optional - FRED API for macro indicators (get from https://fredaccount.stlouisfed.org/login/secure/)
FRED_API_KEY=your_fred_api_key_here

# Optional - Finnhub API for detailed analyst data (get from https://finnhub.io/dashboard/api-key)
FINNHUB_API_KEY=your_finnhub_api_key_here
